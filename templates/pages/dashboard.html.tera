<div>

    <div class="row">
        <div style="display: none;">
            <div class="col-6 date d-flex">
                <span class="input-group-text" id="basic-addon1">Inicio</span>
                <input type="date" class="form-control date1" data-provide="datepicker">
                <span class="input-group-text" id="basic-addon1">Fim</span>
                <input type="date" class="form-control date2" data-provide="datepicker">
            </div>
        </div>

        <div class="col-12 col-lg-6 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold mb-4">Valores por Categoria</h5>
                    <div class="category_values">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold mb-4">Distribuição</h5>
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 py-2 py-sm-0 pe-0">
                            <canvas id="myChart"></canvas>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-8 align-content-around ps-0">
                            <div class="expenses-month p-2"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body">
                    <div class="d-sm-flex d-block align-items-center justify-content-between mb-4">
                        <div class="mb-3 mb-sm-0">
                            <h5 class="card-title fw-semibold">Evolução do Saldo</h5>
                        </div>
                        <div class="d-flex" style="width: 250px;">
                            <div class="input-group input-group-sm">
                                <input type="text" id="balance-months" class="form-control" value="6">
                                <span class="input-group-text">meses</span>
                            </div>
                            <button class="btn btn-sm btn-primary mx-1 px-3" onclick="get_balance()"><span
                                    class="ti ti-search"></span>
                            </button>
                        </div>
                    </div>
                    <div style="min-height: 300px;">
                        <canvas id="balanceChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function search_expenses_category() {
        fetch("search_expenses_category?" + new URLSearchParams({
            "value1": document.getElementsByClassName("date1")[0].value,
            "value2": document.getElementsByClassName("date2")[0].value
        }), { redirect: 'follow' })
            .then((response) => {
                if (response.redirected) window.location.href = response.url;
                return response.json()
            })
            .then((json) => {
                const monthNames = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"];

                let rightTitle = "";
                if (json.months && json.months.length > 0) {
                    let lastMonthData = json.months[json.months.length - 1];
                    let lastMonthName = monthNames[lastMonthData.month - 1];
                    let lastMonthYear = lastMonthData.year.toString().slice(-2);
                    rightTitle = `Gastos ${lastMonthName}/${lastMonthYear}`;
                }

                let endMonth = new Date(document.getElementsByClassName("date2")[0].value.replace(/-/g, '\/')).getMonth() + 1
                let totalMes = json.months[json.months.length - 1].sum

                let tableHTML = `<div class="table-responsive">
                    <table class="table table-sm text-nowrap align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="border-bottom-0 py-1"><h6 class="fw-semibold mb-0 fs-4">Categoria</h6></th>`;

                json.months.forEach(m => {
                    const shortYear = m.year.toString().slice(-2);
                    const monthName = monthNames[m.month - 1];
                    tableHTML += `<th class="border-bottom-0 text-end py-1"><h6 class="fw-semibold mb-0 fs-4">${monthName}/${shortYear}</h6></th>`;
                });

                tableHTML += `</tr>
                        </thead>
                        <tbody>`;

                json.categories.forEach(e => {
                    tableHTML += `<tr>
                        <td class="border-bottom-0 py-1"><h6 class="fw-normal mb-0 text-truncate" style="max-width: 120px;">${e.category}</h6></td>`;

                    e.months.forEach(m => {
                        tableHTML += `<td class="border-bottom-0 text-end py-1" onclick="search_expenses('${e.category}',${m.year},${m.month})">
                            <span class="cursor-pointer">${m.sum === 0 ? '-' : m.sum.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                        </td>`;
                    });
                    tableHTML += `</tr>`;
                });

                tableHTML += `<tr>
                    <td class="border-bottom-0 py-1"><h6 class="fw-semibold mb-0 fs-4">Total</h6></td>`;

                json.months.forEach(m => {
                    tableHTML += `<td class="border-bottom-0 text-end py-1" onclick="search_expenses(null,${m.year},${m.month})">
                        <span class="cursor-pointer fs-4 fw-semibold">${m.sum === 0 ? '-' : m.sum.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                    </td>`;
                });

                tableHTML += `</tr></tbody></table></div>`;
                document.getElementsByClassName("category_values")[0].innerHTML = tableHTML;

                let label = []
                let sum = []

                json.categories.sort(function (a, b) {
                    return a.months[a.months.length - 1].sum < b.months[b.months.length - 1].sum ? 1 : -1
                })

                const chartColors = [
                    '#36A2EB', '#FF6384', '#FF9F40', '#FFCD56', '#4BC0C0', '#9966FF', '#C9CBCF',
                    '#007bff', '#dc3545', '#ffc107', '#28a745', '#17a2b8', '#6610f2', '#fd7e14'
                ];
                let bgColors = [];

                let tableHTML2 = `<div class="table-responsive">
                    <table class="table table-sm text-nowrap align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="border-bottom-0 py-1" colspan="3"><h6 class="fw-semibold mb-0 fs-4 text-center">${rightTitle}</h6></th>
                            </tr>
                        </thead>
                        <tbody>`;

                json.categories.forEach(e => {
                    e.months.forEach(m => {
                        if (m.month == endMonth && m.sum > 0) {
                            label.push(e.category)
                            sum.push(m.sum)
                            let color = chartColors[(label.length - 1) % chartColors.length];
                            bgColors.push(color);

                            tableHTML2 += `<tr>
                                <td class="border-bottom-0 py-1">
                                    <span style="display:inline-block; width:12px; height:12px; background-color:${color}; border-radius:50%; margin-right:5px; vertical-align: middle;"></span>
                                    <span class="fw-normal mb-0 text-truncate" style="max-width: 120px; display: inline-block; vertical-align: middle;">${e.category}</span>
                                </td>
                                <td class="border-bottom-0 text-end py-1">${m.sum.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                                <td class="border-bottom-0 text-end py-1">${(m.sum * 100 / totalMes).toFixed(1)}%</td>
                            </tr>`;
                        }
                    })
                })

                tableHTML2 += `</tbody></table></div>`;
                document.getElementsByClassName("expenses-month")[0].innerHTML = tableHTML2;

                if (graph) {
                    graph.destroy()
                }

                const ctx = document.getElementById('myChart');

                graph = new Chart(ctx, {
                    options: {
                        maintainAspectRatio: false,
                        legend: {
                            display: false
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    },
                    type: 'doughnut',
                    data: {
                        labels: label,
                        datasets: [{
                            label: 'Sum',
                            data: sum,
                            backgroundColor: bgColors,
                            borderWidth: 1
                        }]
                    }
                });

            })
            .catch((error) => {
                console.warn(error);
            });
    }

    function search_expenses(category, year, month) {
        month = month - 1
        let startdate = new Date(year, month, 1, 0, 0).toISOString().split("T")[0]
        let enddate = new Date(year, (month + 1), 0, 0, 0).toISOString().split("T")[0]

        if (category != null) {
            loadPage(window.location.protocol + "//" + window.location.host + "/searchexpenses?category=" + category.replace(" ", "+") + "&startdate=" + startdate + "&enddate=" + enddate, true)
        } else {
            loadPage(window.location.protocol + "//" + window.location.host + "/searchexpenses?startdate=" + startdate + "&enddate=" + enddate, true)
        }
    }

    var today = new Date();
    var lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);
    var firstDayOfMonth = new Date(today.getFullYear(), today.getMonth() - 2, 1);

    document.getElementsByClassName("date1")[0].valueAsDate = firstDayOfMonth
    document.getElementsByClassName("date2")[0].valueAsDate = lastDayOfMonth

    search_expenses_category()

    function get_balance() {

        fetch("get_balance?" + new URLSearchParams({
            "months": document.getElementById("balance-months").value
        }), { redirect: 'follow' })
            .then((response) => {
                if (response.redirected) window.location.href = response.url;
                return response.json()
            })
            .then((json) => {
                let dataset = []

                let legend = {
                    ["balance-month"]: false,
                    ["balance"]: true,
                    ["expenses"]: false,
                    ["incomes"]: false,
                }
                if (graphBalance != undefined) {
                    legend["balance-month"] = graphBalance.legend.legendItems.filter(legend => legend.text == "Saldo Mês")[0].hidden
                    legend["balance"] = graphBalance.legend.legendItems.filter(legend => legend.text == "Saldo Total")[0].hidden
                    legend["expenses"] = graphBalance.legend.legendItems.filter(legend => legend.text == "Despesas")[0].hidden
                    legend["incomes"] = graphBalance.legend.legendItems.filter(legend => legend.text == "Receitas")[0].hidden
                }

                dataset.push({
                    type: 'line',
                    label: 'Saldo Mês',
                    data: json.balance_month.map(item => item.value),
                    borderColor: '#3bb000',
                    backgroundColor: "#3bb000",
                    hidden: legend["balance-month"]
                })
                dataset.push({
                    type: 'line',
                    label: 'Saldo Total',
                    data: json.balance.map(item => item.value),
                    borderColor: '#236b00',
                    backgroundColor: "#236b00",
                    hidden: legend["balance"]
                })
                dataset.push({
                    type: 'bar',
                    label: 'Despesas',
                    data: json.expenses.map(item => item.value), // -Math.abs(item.value)
                    borderColor: '#ed686c',
                    backgroundColor: "#ed686c",
                    hidden: legend["expenses"]
                })
                dataset.push({
                    type: 'bar',
                    label: 'Receitas',
                    data: json.incomes.map(item => item.value),
                    borderColor: '#36a2eb',
                    backgroundColor: "#36a2eb",
                    hidden: legend["incomes"]
                })

                if (graphBalance) {
                    graphBalance.destroy()
                }
                let ctx = document.getElementById('balanceChart');

                graphBalance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: json.labels,
                        datasets: dataset
                    },
                    options: {
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        maintainAspectRatio: false,
                        onClick: (e) => {
                            console.log(e)
                        },
                        scales: {
                            x: {
                                ticks: {
                                    callback: function (value, index, ticks) {
                                        const label = this.getLabelForValue(value);
                                        const [mesNum, ano] = label.split('-');
                                        const meses = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
                                        const nomeMes = meses[parseInt(mesNum, 10) - 1];
                                        return nomeMes ? `${nomeMes}/${ano.slice(2)}` : label;
                                    }
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                labels: {
                                    usePointStyle: true,
                                    padding: 20
                                }
                            }
                        }
                        /*plugins: {
                            legend: {
                                onClick: (e) => {
                                    console.log(e)
                                    console.log(e.chart.legend.legendItems.filter(legend => legend.text == "Balance")[0].hidden)
                                    e.chart.legend.legendItems.filter(legend => legend.text == "Balance")[0].hidden = false
                                }
                            }
                        }*/
                    },
                });
            });

    }

    get_balance()

</script>